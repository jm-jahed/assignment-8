# Browser-accessible endpoints
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# Server-only variables (Next.js server runtime, NEVER with NEXT_PUBLIC_)
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=your_better_auth_secret_here
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/community_connect?retryWrites=true&w=majority
JWT_AUDIENCE=community-connect-api

# OAuth Providers (Google Cloud Console & GitHub Developer Settings)
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
